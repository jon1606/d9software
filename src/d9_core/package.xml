<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>d9_core</name>
  <version>0.1.0</version>
  <description>
    Plain C++17 decision logic for the Mini D9. No ROS or Arduino headers:
    the same sources compile into the ROS nodes and the ESP32 firmware.
  </description>
  <maintainer email="yonathan.transky1@gmail.com">Jonathan</maintainer>
  <license>TBD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
